{
  "name": "lexagent",
  "version": "1.0.0",
  "description": "AI Agent Platform for Law Firms",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
